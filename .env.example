# CTRLpanel Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it is gitignored).
# For production (Cloudflare), set the same values as Worker secrets:
#   npx wrangler secret put <NAME>

# ── Supabase ────────────────────────────────────────────────
# Supabase → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# service_role SECRET key (same Settings → API page).
# Backend-only — bypasses Row-Level Security. Required for:
#   - Google Calendar OAuth (google_tokens is service-role-only by design)
#   - Opportunities Agent runs (writes opportunities + opportunity_runs rows)
# Never expose it to the frontend or commit it anywhere.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-here

# ── Anthropic Claude API ────────────────────────────────────
# console.anthropic.com → API Keys. Optional if every user supplies their own
# key via Settings → Connectors (per-user keys take precedence).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Google OAuth (Google Calendar two-way sync) ─────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web)
# Authorized redirect URIs must include the value of GOOGLE_REDIRECT_URI below
# (register both local + production URLs):
#   http(s)://<host>/api/calendar/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Local dev:   http://localhost:3001/api/calendar/callback
# Production:  https://your-domain/api/calendar/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/callback

# ── YouTube channel analytics (Socials) ─────────────────────
# Uses the SAME Google OAuth client as Calendar, with its own redirect URI.
# In Google Cloud: enable "YouTube Data API v3" + "YouTube Analytics API",
# add the youtube.readonly + yt-analytics.readonly scopes to the consent
# screen, and register this redirect URI alongside the calendar one.
# Optional — defaults to GOOGLE_REDIRECT_URI with /calendar/ → /youtube/
# Local dev:   http://localhost:3001/api/youtube/callback
# Production:  https://your-domain/api/youtube/callback
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/youtube/callback

# ── Google Sheets (CRM backing) — SERVICE ACCOUNT, not OAuth ─
# Google restricts the Sheets scope to OAuth clients whose redirect URIs are
# ALL https, which makes http://localhost dev impossible. So Sheets uses a
# service account instead: no redirect URI, no consent screen, no verification.
#
# Setup (one time), in the same Google Cloud project — the CRM's "Connect
# Google Sheet" window walks through this and has a live connection check:
#   1. Enable the "Google Sheets API".
#   2. IAM & Admin → Service Accounts → Create service account (no roles needed).
#   3. On that account: Keys → Add key → Create new key → JSON → download.
#   4. EITHER put the whole downloaded file in ONE variable (easiest):
#        GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account", ... }'
#      (raw JSON, or its base64) — OR copy `client_email` / `private_key` into the
#      two variables below (keep the key's \n escapes, in double quotes).
#   5. Restart the API server, then in the CRM press "Check again".
#   6. In Google Sheets, share each spreadsheet with the service account's email:
#      Viewer = read-only in CTRLpanel, Editor = edit/add/delete rows here too.
# Production (Cloudflare): `npx wrangler secret put GOOGLE_SERVICE_ACCOUNT_JSON`.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=ctrlpanel-sheets@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ── Stock prices (optional) ─────────────────────────────────
# alphavantage.co free API key. Without it, stock/ETF prices fall back to
# deterministic mock values (crypto always uses CoinGecko, no key needed).
ALPHA_VANTAGE_KEY=

# ── Local dev server ────────────────────────────────────────
PORT=3001
# SPA origin, used for CORS + post-OAuth redirects.
# Local dev: http://localhost:5173 · Production: https://your-domain
FRONTEND_URL=http://localhost:5173
